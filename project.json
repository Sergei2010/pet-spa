{
	"name": "pet-spa",
	"$schema": "../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "pet-spa/src",
	"tags": [],
	"targets": {
		"serve": {
			"executor": "@nx/vite:dev-server",
			"options": {
				"buildTarget": "pet-spa:build",
				"configFile": "pet-spa/vite.config.ts"
			}
		},
		"build": {
			"executor": "@nx/vite:build",
			"options": {
				"configFile": "pet-spa/vite.config.ts",
				"outputPath": "public"
			}
		}
	}
}
